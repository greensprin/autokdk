
#include <dt-bindings/zmk/matrix_transform.h>
#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>
#include "layouts.dtsi"

/ {
    chosen {
        zmk,physical-layout = &physical_layout0;
    };

    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <14>;
        rows = <5>;
        map = <
            RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5) RC(0,8) RC(0,9) RC(0,10) RC(0,11) RC(0,12) RC(0,13)
			RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5) RC(1,8) RC(1,9) RC(1,10) RC(1,11) RC(1,12) RC(1,13)
			RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5) RC(2,8) RC(2,9) RC(2,10) RC(2,11) RC(2,12) RC(2,13)
			RC(3,0) RC(3,1) RC(3,2) RC(3,3) RC(3,4) RC(3,5) RC(3,6) RC(3,7) RC(3,8) RC(3,9) RC(3,10) RC(3,11) RC(3,12) RC(3,13)
			RC(4,0) RC(4,1) RC(4,2) RC(4,3) RC(4,4) RC(4,5) RC(4,6) RC(4,7) RC(4,8) RC(4,12) RC(4,13)
        >;
		col-offset = <7>;
    };

    kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        wakeup-source;

        diode-direction = "col2row";
        row-gpios
            = <&akdk_d 11 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
			,<&akdk_d 15 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
			,<&akdk_d 16 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
			,<&akdk_d 17 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
			,<&akdk_d 18 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            ;
        col-gpios
            = <&akdk_d 14 GPIO_ACTIVE_HIGH>
			,<&akdk_d 13 GPIO_ACTIVE_HIGH>
			,<&akdk_d 12 GPIO_ACTIVE_HIGH>
			,<&akdk_d 6 GPIO_ACTIVE_HIGH>
			,<&akdk_d 5 GPIO_ACTIVE_HIGH>
			,<&akdk_d 4 GPIO_ACTIVE_HIGH>
			,<&akdk_d 3 GPIO_ACTIVE_HIGH>
            ;
    };

    /* 横スクロール(HWHEEL)だけに掛ける専用スケーラ。
     * 標準の zip_scroll_scaler と違って track-remainders を付けていないので
     * 端数が切り捨てられる = 小さい横成分を捨てるデッドゾーンとして働く。
     * <1 N> で「1 イベントの横移動量が N 未満なら 0 にする」。
     * N を大きくするほど横に転がりにくくなる (縦スクロール時の斜めズレが減る)。
     */
    zip_hscroll_deadzone: zip_hscroll_deadzone {
        compatible = "zmk,input-processor-scaler";
        #input-processor-cells = <2>;
        type = <INPUT_EV_REL>;
        codes = <INPUT_REL_HWHEEL>;
    };

    /* デッドゾーンで 1/N に減った分を掛け戻すためのスケーラ (同じく端数保持なし)。
     * <N 1> と、上の deadzone の N を必ず揃えること。これで
     * 「閾値を超えた横移動は元の速度のまま」を保てる。
     */
    zip_hscroll_gain: zip_hscroll_gain {
        compatible = "zmk,input-processor-scaler";
        #input-processor-cells = <2>;
        type = <INPUT_EV_REL>;
        codes = <INPUT_REL_HWHEEL>;
    };

    trackball_listener: trackball_listener {
        compatible = "zmk,input-listener";
        device = <&trackball>;
        /* Sensor is mounted rotated 180 degrees, which already inverts both
         * axes, so no additional X/Y inversion is applied here.
         *
         * zip_xy_scaler <mult div> でカーソル感度を調整する (端数は内部で
         * 保持されるので、遅い動きの精度は落ちない)。
         *   1 2 = 1/2 (既定, 感度半分) / 1 3 = 1/3 (さらに遅く) / 2 3 = 2/3
         * さらに大きく下げたい場合は下の trackball ノードに
         * res-cpi = <608>; (最小値) を追加してセンサ側の解像度も落とす。
         */
        input-processors = <&zip_xy_transform 0>, <&zip_xy_scaler 1 2>;

        /* mo 2 (layer 2) を押している間はトラックボールをスクロールにする。
         * 一致した override が処理されると base の processors は実行されない
         * ため、ここに必要な processor をすべて並べている。
         * INPUT_TRANSFORM_Y_INVERT: ボールを前に転がすと上方向スクロール。
         *   逆方向が好みなら 0 に変更する。
         * zip_scroll_scaler <mult div>: div を大きくするとスクロールが遅くなる。
         *
         * zip_hscroll_deadzone / zip_hscroll_gain のペアで横スクロールにだけ
         * デッドゾーンを掛けている。縦に転がしたときの微小な横ブレが消えるので、
         * 斜めスクロールにならない。横に転がしたいときは、はっきり横に動かす。
         * 横が出すぎる → 4 を大きく (5, 6, ...) / 横に動かしても効かない → 小さく (3, 2)。
         * 2 か所の数値は必ず同じ値にすること。
         */
        scroller {
            layers = <2>;
            input-processors = <&zip_xy_transform INPUT_TRANSFORM_Y_INVERT>,
                               <&zip_xy_to_scroll_mapper>,
                               <&zip_hscroll_deadzone 1 4>,
                               <&zip_hscroll_gain 4 1>,
                               <&zip_scroll_scaler 1 30>;
        };
    };
};

&physical_layout0 {
    kscan = <&kscan0>;
    transform = <&default_transform>;
};

&pinctrl {
    spi0_default: spi0_default {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 0, 12)>,
                <NRF_PSEL(SPIM_MOSI, 1, 9)>,
                <NRF_PSEL(SPIM_MISO, 1, 9)>;
        };
    };

    spi0_sleep: spi0_sleep {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 0, 12)>,
                <NRF_PSEL(SPIM_MOSI, 1, 9)>,
                <NRF_PSEL(SPIM_MISO, 1, 9)>;
            low-power-enable;
        };
    };
};

&spi0 {
    status = "okay";
    compatible = "nordic,nrf-spim";
    pinctrl-0 = <&spi0_default>;
    pinctrl-1 = <&spi0_sleep>;
    pinctrl-names = "default", "sleep";
    cs-gpios = <&gpio0 13 GPIO_ACTIVE_LOW>;

    trackball: trackball@0 {
        status = "okay";
        compatible = "pixart,paw3222";
        reg = <0>;
        spi-max-frequency = <2000000>;
        irq-gpios = <&gpio0 15 GPIO_ACTIVE_LOW>;
    };
};

